# Only the mod sources and the root README are tracked. Everything around
# them in this workspace (the game build, the AppImage, extracted copies,
# archives, local state) stays on the machine.
*
!.gitignore
!README.md
!DEVELOPING.md
!install.sh
!install.bat
!play.sh
!play.command
!play.bat
!modloader/
!modloader/**
!skillhud-mod/
!skillhud-mod/**
!uitweaks-mod/
!uitweaks-mod/**
!lootfilter-mod/
!lootfilter-mod/**

# generated on each machine by the installers (never commit them)
modloader/app-path.txt
modloader/game-path.txt
modloader/win-sync.vbs
